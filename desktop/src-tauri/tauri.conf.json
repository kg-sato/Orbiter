{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbiter",
  "version": "0.6.6",
  "identifier": "com.kgsato.orbit",
  "build": {
    "frontendDist": "../../build/native"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; style-src-attr 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBNzJCMTk3MUI4MzY5NDIKUldSQ2FZTWJsN0Z5V2xzRmRIcWIvQTA0RnBTOWhCbS9VMnh5RzIzdVdJRENucmwvQjl4YnBPbFIK",
      "endpoints": [
        "https://github.com/kg-sato/Orbiter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
